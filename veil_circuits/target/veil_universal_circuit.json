y_y,\n        signature,\n        message_hash\n    );\n    assert(is_authentic);\n\n    // 2. RULE EVALUATION: Verify User meets the Program's requirements\n    assert(user_balance >= min_balance);\n    assert(user_prs >= min_prs);\n}\n","path":"/home/mayank-tiwari/Projects/veil/veil_circuits/src/main.nr"}},"names":["main"]}